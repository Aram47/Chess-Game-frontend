# --- development (`npm run dev` / `npm run build:dev`) ---
# Vite proxy target. The browser still calls relative /api, /game, ...
VITE_APP_API_URL=http://localhost:3000

# --- production (`npm run build:prod` / Docker) ---
# Leave empty so the SPA uses the current host. Backend nginx on
# https://chessmaster-tigran.duckdns.org proxies API prefixes to Nest.
# VITE_APP_API_URL=

VITE_API_PATH=/api

VITE_GAME_PATH=/game

VITE_OWNER_SERVICE_PATH=/owner-service
